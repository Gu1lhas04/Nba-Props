# ============================================
# DJANGO CORE SETTINGS
# ============================================
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True

# ============================================
# POSTGRESQL DATABASE
# ============================================
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost

# ============================================
# MONGODB SETTINGS (para cache NBA)
# ============================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=nba_cache
MONGODB_USER=
MONGODB_PASSWORD=

# ============================================
# REDIS SETTINGS (para WebSockets)
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ============================================
# ASGI/WEBSOCKET
# ============================================
DJANGO_ASGI=True

# ============================================
# PROXY SETTINGS (opcional)
# ============================================
PROXY_ENABLED=False
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
REQUEST_TIMEOUT=30
